// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String
  password  String
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  user        User         @relation(fields: [userId], references: [id])
  userId      Int
  createdAt   DateTime     @default(now())
  updatedAt temporal.updatedAt()
}

enum TaskStatus {
  @@type("pg/text@1")
  todo        = "todo"
  in_progress = "in_progress"
  done        = "done"
}

enum TaskPriority {
  @@type("pg/text@1")
  low    = "low"
  medium = "medium"
  high   = "high"
}
